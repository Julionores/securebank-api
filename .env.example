# Copier ce fichier vers ".env" et renseigner de vraies valeurs.
# ".env" est dans .gitignore : ne JAMAIS committer de secret réel.

DB_PASSWORD=change-me
# 32 caractères minimum - générer avec: openssl rand -base64 48
JWT_SECRET=change-me-with-a-real-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:4200
